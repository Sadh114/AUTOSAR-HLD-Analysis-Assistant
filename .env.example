# Copy this file to ".env" and fill in your own values.
# Both are free-tier: https://console.groq.com (Groq) or https://aistudio.google.com (Gemini)

# Which provider to use: "groq" or "gemini"
LLM_PROVIDER=groq

# --- Groq (default, recommended free option) ---
GROQ_API_KEY=your_groq_api_key_here
# Groq periodically retires older model ids. If you get a "model_not_found"
# error, run this to see currently available models for your key:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer YOUR_KEY"
GROQ_MODEL=openai/gpt-oss-20b

# --- Gemini (alternative free option) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Embedding model (runs locally, no key needed) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Optional: only needed if Tesseract is not on your system PATH ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Backend server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
